PORT=8081
# Comma-separated allowed frontend origins (Vite often shifts to 5174 if 5173 is taken)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=khaanakrush
DB_PORT=3306

# Prisma (optional; Prisma 7 also requires a driver adapter to run)
DATABASE_URL=mysql://root:your_password@localhost:3306/khaanakrush

